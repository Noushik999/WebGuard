# Copy to ../.env and fill in. NEVER commit .env.
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string-in-production
DATABASE_URL=sqlite:///../webguard.db
FRONTEND_URL=http://localhost:5173

# Scanner safety: keep false unless running the local lab demo.
ALLOW_PRIVATE_NETWORKS=false
SCAN_TIMEOUT_SECONDS=120
SCAN_MAX_REQUESTS=40
SCAN_REQUEST_TIMEOUT=10.0

# Optional: LLM analyst enrichment (OpenAI-compatible). Empty = rule-based analyst only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Bootstrapped on first run only — change immediately after login.
ADMIN_EMAIL=admin@webguard.local
ADMIN_PASSWORD=webguard-admin
